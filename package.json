{
  "name": "slov-lex_mcp",
  "version": "1.3.0",
  "description": "MCP server for Slov-Lex: search legal acts and load dated versions, paragraphs and recent publications.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm test",
    "presmoke": "npm run build",
    "smoke": "node dist/smoke.js",
    "install:browser": "playwright install chromium"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "slov-lex",
    "slovakia",
    "law"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cheerio": "^1.2.0",
    "lru-cache": "^11.3.5",
    "playwright": "^1.59.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
